<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><% if (page.title) { %><%= page.title %> - <% } %><%= config.title %></title>
<meta name="description" content="<%= page.description || page.excerpt || config.description %>">
<meta name="author" content="<%= config.author %>">

<!-- 字体 -->
<link href="https://font.onmicrosoft.cn/lxgw-wenkai-screen-webfont@1.6.0/style.css" rel="stylesheet">
<link href="https://static.iirose.cn/font/JetBrainMono/JetbrainMono.css" rel="stylesheet">

<!-- Bootstrap CSS (for modal functionality) -->
<link href="<%= url_for('css/bootstrap.min.css') %>" rel="stylesheet">

<!-- CSS -->
<link rel="stylesheet" href="<%= url_for('css/style.css') %>">

<!-- Favicon -->
<link rel="icon" href="<%= url_for('favicon.ico') %>">

<!-- RSS -->
<link rel="alternate" type="application/rss+xml" title="<%= config.title %>" href="<%= url_for('atom.xml') %>">
