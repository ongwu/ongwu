<div class="sidebar-content">
    <!-- 品牌标识区域 -->
    <% if (theme.sidebar.show_profile !== false) { %>
    <div class="brand-section">
        <a href="/" class="brand-link">
            <img src="<%= theme.avatar || '/images/avatar.jpg' %>" alt="<%= theme.author_name || 'Logo' %>" class="brand-avatar">
            <div class="brand-text">
                <h1 class="site-name"><%= theme.site_title || config.title %></h1>
                <p class="site-subtitle"><%= theme.quote || config.subtitle %></p>
            </div>
        </a>
    </div>
    <% } %>
    
    <!-- 导航菜单 -->
    <% if (theme.sidebar.show_menu !== false) { %>
    <nav class="sidebar-nav">
        <ul>
            <% if (theme.menu && theme.menu.length > 0) { %>
                <% theme.menu.forEach(function(item) { %>
                    <li><a href="<%= url_for(item.url) %>"><%= item.name %></a></li>
                <% }); %>
            <% } else { %>
                <li><a href="<%= url_for('/') %>">首页</a></li>
                <li><a href="<%= url_for('guestbook') %>">留言</a></li>
                <li><a href="<%= url_for('links') %>">友链</a></li>
                <li><a href="<%= url_for('about') %>">关于</a></li>
            <% } %>
        </ul>
    </nav>
    <% } %>
    
    <!-- 搜索模块 -->
    <% if (theme.sidebar.show_search !== false && theme.search.enable !== false) { %>
    <div class="search-section">
        <div class="search-label">站内搜索</div>
        <div class="search-box">
            <input type="text" id="search-input" placeholder="<%= theme.search.placeholder || '搜索文章...' %>" data-bs-toggle="modal" data-bs-target="#searchModal" readonly>
            <div class="search-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.5"/>
                    <path d="m21 21-4.35-4.35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </div>
        </div>
    </div>
    <% } %>
    
    <!-- 欢迎语区域 -->
    <% if (theme.sidebar.show_welcome !== false) { %>
    <div class="welcome-section">
        <h3 class="welcome-title"><%= theme.welcome.title || 'Hi，旅行者：' %></h3>
        <p class="welcome-text"><%= theme.welcome.content || '欢迎来到我的小站呀，很高兴遇见你！' %></p>
    </div>
    <% } %>
    
    
    <!-- 最近更新 -->
    <div class="recent-updates">
        <h3>最近更新</h3>
        <ul>
            <% if (site.posts && site.posts.length > 0) { %>
                <% site.posts.sort('date', -1).limit(5).each(function(post) { %>
                    <li>
                        <a href="<%= url_for(post.path) %>"><%= post.title %></a>
                    </li>
                <% }); %>
            <% } else { %>
                <li>暂无文章</li>
            <% } %>
        </ul>
    </div>
</div>
